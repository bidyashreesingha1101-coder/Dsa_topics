#include <stdio.h>

#define SIZE 4

int queue[SIZE];
int front = -1, rear = -1;

void enqueue(int job) {
    if ((rear + 1) % SIZE == front) {
        printf("Queue Overflow\n");
        return;
    }
    if (front == -1) {
        front = 0;
        rear = 0;
    } else {
        rear = (rear + 1) % SIZE;
    }
    queue[rear] = job;
}

int dequeue() {
    if (front == -1) {
        printf("Queue Underflow\n");
        return -1;
    }
    int item = queue[front];
    if (front == rear) {
        front = -1;
        rear = -1;
    } else {
        front = (front + 1) % SIZE;
    }
    return item;
}

void printQueue() {
    if (front == -1) {
        printf("Queue is empty\n");
        return;
    }
    printf("Queue elements (from front to rear with indices):\n");
    int i = front;
    while (1) {
        printf("Index %d: Job %d\n", i, queue[i]);
        if (i == rear) break;
        i = (i + 1) % SIZE;
    }
}

int main() {
    // Add four job numbers
    enqueue(1);
    enqueue(2);
    enqueue(3);
    enqueue(4);

    // Dequeue one job
    int dequeuedJob = dequeue();
    printf("Dequeued Job: %d\n", dequeuedJob);

    // Add one more job (will wrap around to index 0)
    enqueue(5);

    // Print queue from front to rear with indices
    printQueue();

    return 0;
}
